APP_NAME="Thesis API"
DEBUG=true

# postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/thesis

# Comma-separated list is not supported by pydantic-settings list parsing from
# env vars by default; provide as a JSON array string instead, e.g.:
CORS_ORIGINS=["http://localhost:3000"]
